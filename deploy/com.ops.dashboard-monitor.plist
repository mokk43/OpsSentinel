<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ops.dashboard-monitor</string>

    <!-- Update these paths for the always-on host -->
    <key>ProgramArguments</key>
    <array>
        <string>/ABS/PATH/TO/OpsSentinel/.venv/bin/python</string>
        <string>-m</string>
        <string>monitor</string>
        <string>run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ABS/PATH/TO/OpsSentinel</string>

    <!-- Every 10 minutes; app no-ops outside Mon–Fri 09:30–18:10 Asia/Shanghai -->
    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/ABS/PATH/TO/OpsSentinel/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/ABS/PATH/TO/OpsSentinel/logs/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Optional: point at a specific .env if not next to WorkingDirectory -->
        <!-- <key>ENV_FILE</key><string>/ABS/PATH/TO/OpsSentinel/.env</string> -->
    </dict>
</dict>
</plist>
