# Timezone / schedule
TZ_NAME=Asia/Shanghai
CHECK_INTERVAL_MINUTES=10
# Business window is Mon–Fri 09:30–18:10 in TZ_NAME (enforced in code)

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=
LLM_MODEL=

# Image budget for fail-closed capture (bytes / max side length in CSS pixels * scale)
LLM_MAX_IMAGE_BYTES=10485760
LLM_MAX_IMAGE_SIDE_PX=8000

# Alerter
ALERT_BASE_URL=http://127.0.0.1:9780
ALERT_SOURCE_UUID=
ALERT_PUSH_CREDENTIAL=

# Paths (relative to project root unless absolute)
DASHBOARDS_FILE=./dashboards.yaml
SCREENSHOT_DIR=./screenshots
SCREENSHOT_KEEP_HOURS=12
STORAGE_STATE_DIR=./storage_state
LOCK_FILE=./.monitor.lock
STATE_FILE=./state.json
LOG_DIR=./logs

# Runtime
RUN_TIMEOUT_SECONDS=480
PAGE_GOTO_TIMEOUT_MS=30000
PAGE_SETTLE_MS=2000
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
DEVICE_SCALE_FACTOR=2

# Optional board-vs-login heuristics (comma-separated substrings, case-insensitive)
# If the final URL/title matches any login marker → auth failure
LOGIN_URL_MARKERS=login,signin,sso,passport,auth
LOGIN_TITLE_MARKERS=login,sign in,登录,登入
# If set, final URL must contain at least one of these (comma-separated)
# SUCCESS_URL_MARKERS=
